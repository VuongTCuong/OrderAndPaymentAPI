@page
@model OrderAndPaymentAPI.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Sản phẩm";
    bool isAdmin = User.IsInRole("admin");
}

<div class="container page-head">
    <h1>Sản phẩm</h1>
    <p>@Model.Products.Count sản phẩm đang có sẵn</p>
    @if (isAdmin)
    {
        <a class="btn btn-primary" asp-page="/Products/Create">Thêm sản phẩm</a>
    }
</div>

@if (!ViewData.ModelState.IsValid)
{
    <div class="container product-errors" asp-validation-summary="All" role="alert"></div>
}

<div class="container product-grid">
    @foreach (var product in Model.Products)
    {
        <div class="product-card">
            <h3>@product.Name</h3>
            <div class="product-price">@product.Price.ToString("N0") ₫</div>
            <div class="product-stock">Còn @product.Stock sản phẩm</div>

            @if (isAdmin)
            {
                <div style="display:flex; gap:8px;">
                    <a class="btn btn-outline btn-sm" asp-page="/Products/Edit" asp-route-id="@product.Id">Sửa</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@product.Id" onsubmit="return confirm('Bạn có chắc muốn xóa sản phẩm này không?');">
                        <button type="submit" class="btn btn-outline btn-sm">Xóa</button>
                    </form>
                </div>
            }
            else
            {
                <form method="post" class="product-add-form">
                    <input type="hidden" name="productId" value="@product.Id" />
                    <div class="product-quantity-row">
                        <label for="quantity-@product.Id">Số lượng</label>
                        <div class="quantity-control">
                            <button type="button" class="quantity-step" data-step="-1" aria-label="Giảm số lượng" disabled>−</button>
                            <input id="quantity-@product.Id" name="quantity" type="number" min="1" max="@Math.Max(1, product.Stock)" step="1" value="1" required disabled="@(product.Stock <= 0)" />
                            <button type="button" class="quantity-step" data-step="1" aria-label="Tăng số lượng" disabled="@(product.Stock <= 1)">+</button>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-outline btn-block" disabled="@(product.Stock <= 0)">@(product.Stock > 0 ? "Thêm vào giỏ" : "Hết hàng")</button>
                </form>
            }
        </div>
    }
</div>
<script src="~/js/product-quantity.js" asp-append-version="true" defer></script>
