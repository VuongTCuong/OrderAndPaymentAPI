@page
@model OrderAndPaymentAPI.Web.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Sản phẩm";
}

<div class="container page-head">
    <h1>Sản phẩm</h1>
    <p>@Model.Products.Count sản phẩm đang có sẵn</p>
</div>

<div class="container product-grid">
    @foreach (var product in Model.Products)
    {
        <div class="product-card">
            <h3>@product.Name</h3>
            <div class="product-price">@product.Price.ToString("N0") ₫</div>
            <div class="product-stock">Còn @product.Stock sản phẩm</div>
            <form method="post">
                <input type="hidden" name="productId" value="@product.Id" />
                <button type="submit" class="btn btn-outline btn-block">Thêm vào giỏ</button>
            </form>
        </div>
    }
</div>
