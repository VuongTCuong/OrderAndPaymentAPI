@using System.Security.Claims
@inject OrderAndPaymentAPI.Services.ICartService CartService
@{
    var cartCount = 0;
    var showCart = !User.IsInRole("admin");
    var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (showCart && User.Identity?.IsAuthenticated == true && !string.IsNullOrEmpty(userIdClaim))
    {
        var cart = await CartService.GetCartByUserIdAsync(userIdClaim);
        cartCount = cart?.CartItems.Count ?? 0;
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Orderly</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a class="brand" href="/">Order<span>ly</span></a>
            <nav class="nav">
                <a href="/Products">Sản phẩm</a>
                @if (showCart)
                {
                    <a href="/CartPage">Giỏ hàng <span class="nav-cart-count">@cartCount</span></a>
                }
                <a href="/Orders">Đơn hàng</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/">Chào mừng '@User.Identity.Name'</a>
                    <form method="post" action="/Account/Login?handler=Logout" class="logout-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline btn-sm">Đăng xuất</button>
                    </form>
                }
                else
                {
                    <a href="/Account/Login">Đăng nhập</a>
                    
                }
            </nav>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            Orderly — giao diện demo dựa trên OrderAndPaymentAPI
        </div>
    </footer>
</body>
</html>
