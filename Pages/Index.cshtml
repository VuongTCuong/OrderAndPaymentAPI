@page
@model OrderAndPaymentAPI.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Trang chủ";
}

<section class="container hero">
    <h1>Mua sắm gọn gàng, thanh toán rõ ràng.</h1>
    <p>Duyệt sản phẩm, quản lý giỏ hàng và theo dõi đơn hàng — tất cả trong một nơi.</p>
    <a class="btn btn-primary" href="/Products">Xem sản phẩm</a>

    <div class="hero-links">
        <div class="hero-card">
            <h3>Giỏ hàng</h3>
            <p>Xem lại các sản phẩm đã chọn trước khi thanh toán.</p>
        </div>
        <div class="hero-card">
            <h3>Đơn hàng</h3>
            <p>Theo dõi trạng thái từng đơn: đang xử lý, hoàn thành hay đã hủy.</p>
        </div>
        <div class="hero-card">
            <h3>Tài khoản</h3>
            <p>Đăng nhập để lưu giỏ hàng và lịch sử mua sắm.</p>
        </div>
    </div>
</section>
